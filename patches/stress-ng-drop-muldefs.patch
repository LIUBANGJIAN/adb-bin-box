--- a/Makefile
+++ b/Makefile
@@ -320,8 +320,14 @@
 # Static flags, only to be used when using GCC
 #
 ifeq ($(STATIC),1)
-override LDFLAGS += -static -z muldefs -ffunction-sections -fdata-sections -Wl,--gc-sections
+# zig's cc driver rejects the GNU-ld-only `-z muldefs` ("unsupported linker
+# extension flag") and equally rejects the lld spelling
+# `--allow-multiple-definition` ("unsupported linker arg"), so the flag cannot
+# be passed through `zig cc` at all.  `-fcommon` is the compile-time equivalent
+# for the tentative-definition case the flag used to paper over.
+override LDFLAGS += -static -ffunction-sections -fdata-sections -Wl,--gc-sections
 override CFLAGS += -DBUILD_STATIC
+override CFLAGS += -fcommon
 endif
 
