# CMake cross-toolchain template for adb-bin-box.
#
# Rendered per (tool, abi) by build/systems/cmake.sh with sed: every @TOKEN@ is
# substituted.  The compiler is Zig's bundled clang driver configured for the
# musl target from build/verify/abi_matrix.json (never hardcoded in a script).

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@")

set(CMAKE_C_COMPILER   "@ZIG_BIN@" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_ARG1 "cc")
set(CMAKE_CXX_COMPILER "@ZIG_BIN@" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER_ARG1 "c++")

set(CMAKE_C_COMPILER_TARGET   "@ZIG_TARGET@")
set(CMAKE_CXX_COMPILER_TARGET "@ZIG_TARGET@")

set(CMAKE_AR     "@AR@"     CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "@RANLIB@" CACHE FILEPATH "" FORCE)

set(CMAKE_FIND_ROOT_PATH "@PREFIX@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_INSTALL_PREFIX "@PREFIX@")
set(CMAKE_EXE_LINKER_FLAGS "-static" CACHE STRING "" FORCE)
set(CMAKE_SHARED_LIBRARY_LINK_C_FLAGS "" CACHE STRING "" FORCE)
